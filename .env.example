# Telegram bot that posts Bluebook start-code events (server-side only, never expose to the browser)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# OPTIONAL server-side allowlist of valid Bluebook start codes.
# Leave empty to accept any well-formed 6-digit code. If set, only these codes pass.
# Six digits each; separate several with commas or spaces. Never exposed to the browser.
START_ACCESS_CODES=
